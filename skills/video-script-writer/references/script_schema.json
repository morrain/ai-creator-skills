{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "ExplainerVideoScript",
  "description": "Schema definition for 4-track explainer video scripts in ai-creator-skills",
  "type": "object",
  "required": [
    "metadata",
    "units"
  ],
  "properties": {
    "metadata": {
      "type": "object",
      "required": [
        "title",
        "target_duration_seconds",
        "genre",
        "mode"
      ],
      "properties": {
        "title": {
          "type": "string",
          "description": "Video title"
        },
        "target_duration_seconds": {
          "type": "integer",
          "minimum": 10,
          "description": "Estimated total duration in seconds"
        },
        "genre": {
          "type": "string",
          "description": "Genre style (e.g. 科普解说, 科技评论)"
        },
        "mode": {
          "type": "string",
          "enum": [
            "article_derived",
            "standalone_topic"
          ],
          "description": "Input mode: article_derived (模式1) or standalone_topic (模式2)"
        },
        "source_article_path": {
          "type": "string",
          "description": "Path to source article if mode is article_derived"
        },
        "visual_theme": {
          "type": "object",
          "description": "Global visual theme and color palette tokens for consistency",
          "required": ["preset", "tokens"],
          "properties": {
            "preset": { "type": "string" },
            "style_description": { "type": "string" },
            "tokens": {
              "type": "object",
              "properties": {
                "canvas_bg": { "type": "string" },
                "card_bg": { "type": "string" },
                "card_border": { "type": "string" },
                "primary_accent": { "type": "string" },
                "secondary_accent": { "type": "string" },
                "warning_accent": { "type": "string" },
                "success_accent": { "type": "string" },
                "text_primary": { "type": "string" },
                "subtitle_box_bg": { "type": "string" },
                "subtitle_box_border": { "type": "string" }
              }
            }
          }
        }
      }
    },
    "units": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "unit_id",
          "duration_seconds",
          "voiceover",
          "visual_prompt",
          "ip_action"
        ],
        "properties": {
          "unit_id": {
            "type": "string",
            "description": "Unit identifier (e.g. Unit 01)"
          },
          "duration_seconds": {
            "type": "integer",
            "minimum": 1,
            "description": "Duration for this scene in seconds"
          },
          "voiceover": {
            "type": "string",
            "minLength": 1,
            "description": "Verbatim spoken text for TTS"
          },
          "visual_prompt": {
            "type": "string",
            "minLength": 1,
            "description": "Scene visual background and atmosphere description. For units >20s, must combine voiceover text to detail multi-stage visual progression (e.g. [0-10s] -> [10-20s] -> [20-30s])."
          },
          "ip_action": {
            "type": "string",
            "minLength": 1,
            "description": "Specific action performed by IP Mascot. For units >20s, must detail multi-stage physical action sequence mapped to voiceover pacing."
          },
          "on_screen_elements": {
            "type": "object",
            "properties": {
              "title_card": {
                "type": "string",
                "description": "Optional scene title (typically only for Unit 01 Hook or major section breaks)"
              },
              "highlight_keywords": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "description": "Optional keywords to highlight on screen"
              },
              "graphics_hint": {
                "type": "string",
                "description": "Optional UI component/diagram hint"
              }
            }
          }
        }
      }
    }
  }
}
